{
  "crons": [
    { "path": "/api/keepalive", "schedule": "17 3 * * *" }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/:page(about|join|resources|map|handbook|events|column|match|lessons|member|privacy|logout)", "destination": "/p/:page.html" },
    { "source": "/column/:slug", "destination": "/p/column/:slug.html" },
    { "source": "/events/:slug", "destination": "/p/events/:slug.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
